# Copy this to .env and fill in your keys

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# LLM — at least one required
# Groq (recommended): https://console.groq.com  → API Keys → Create (free)
GROQ_API_KEY=gsk_...

# Gemini fallback (optional): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# HuggingFace (optional but recommended — avoids rate limits on NER)
# https://huggingface.co/settings/tokens → New token (read access, free)
HF_API_TOKEN=hf_...
